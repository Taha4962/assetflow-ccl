# Used only by the local Vite development proxy; it is not exposed to browser code.
API_PROXY_TARGET=http://localhost:5000

# Enable the developer-only quick login page during local development.
# The route is also disabled automatically in production builds.
VITE_DEV_LOGIN_ENABLED=true
VITE_DEV_LOGIN_PATH=/local-development-login
VITE_DEV_LOGIN_CONFIG_PATH=/developer-login-config
